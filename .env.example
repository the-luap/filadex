# Database Configuration
# Option 1: PostgreSQL (default for multi-user deployments)
# DATABASE_URL=postgres://filadex:filadex@db:5432/filadex
POSTGRES_USER=filadex
POSTGRES_PASSWORD=filadex
POSTGRES_DB=filadex
PGHOST=db
PGPORT=5432

# Option 2: SQLite (single-user install option)
# When using SQLite, no separate database container is required.
# In Docker, point to a path in a persistent volume (e.g. /data/filadex.db):
# DATABASE_URL=file:/data/filadex.db
# In local development a relative path is fine:
# DATABASE_URL=file:./dev.db
# It is refused when NODE_ENV=production, because it resolves against the
# container's own working directory rather than the mounted volume - the install
# works and is destroyed by the next restart.

# Where SQLite backup snapshots are written. Defaults to /data/backups in
# production and ./data/backups in development, so it only needs setting to move
# them elsewhere. Point it at a directory of its own: everything in there named
# filadex-backup-*.db is subject to retention pruning.
# BACKUP_DIR=/data/backups

# Application Configuration
APP_PORT=8080
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARN, ERROR

# Secret used to sign login sessions (JWT). Set this to a long random string
# (e.g. `openssl rand -hex 32`) so sessions survive container restarts.
# If unset, a random secret is generated on each startup and all users are logged out on restart.
JWT_SECRET=

# Set to "true" only if this instance runs behind a trusted reverse proxy
# (e.g. Traefik/Nginx in a SaaS deployment). This makes rate limiting and
# logging use the real client IP from X-Forwarded-For instead of the proxy's.
# Do NOT set this if the app is reachable directly - it would let clients
# spoof their IP and bypass rate limiting.
TRUST_PROXY=false

# Admin User Configuration
ADMIN_PASSWORD=admin
