{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && npm run build:server:pg && npm run build:server:sqlite && npm run build:migrate:pg && npm run build:migrate:sqlite && npm run build:seed:pg && npm run build:seed:sqlite",
    "build:server:pg": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.pg.js",
    "build:server:sqlite": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.sqlite.js --tsconfig=tsconfig.sqlite.json",
    "build:migrate:pg": "esbuild scripts/migrate.pg.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/migrate.pg.js",
    "build:migrate:sqlite": "esbuild scripts/migrate.sqlite.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/migrate.sqlite.js --tsconfig=tsconfig.sqlite.json",
    "build:seed:pg": "esbuild scripts/seed.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/seed.pg.js",
    "build:seed:sqlite": "esbuild scripts/seed.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/seed.sqlite.js --tsconfig=tsconfig.sqlite.json",
    "vite:build": "vite build",
    "start": "NODE_ENV=production node dist/index.pg.js",
    "check": "tsc",
    "check:sqlite": "tsc -p tsconfig.sqlite.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:sqlite": "TS_NODE_PROJECT=tsconfig.sqlite.json drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:check-drift": "tsx scripts/check-migration-drift.ts",
    "db:push": "drizzle-kit push",
    "db:init": "tsx scripts/seed.ts --starter",
    "db:seed": "tsx scripts/seed.ts --demo",
    "db:migrate:sqlite": "tsx --tsconfig=tsconfig.sqlite.json scripts/migrate.sqlite.ts",
    "db:init:sqlite": "tsx --tsconfig=tsconfig.sqlite.json scripts/seed.ts --starter",
    "db:seed:sqlite": "tsx --tsconfig=tsconfig.sqlite.json scripts/seed.ts --demo",
    "db:verify-upgrade": "tsx scripts/verify-upgrade.ts",
    "setup": "bash scripts/setup-local.sh",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-hover-card": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.1",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.2.0",
